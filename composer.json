{
  "name": "austral/entity-bundle",
  "type": "symfony-bundle",
  "description": "Tools for Symfony Entity",
  "keywords": [
    "Austral",
    "Entity",
    "Symfony",
    "EntityManager"
  ],
  "license": "MIT",
  "homepage": "https://austral.dev",
  "authors": [
    {
      "name": "Matthieu Beurel",
      "email": "matthieu@austral.dev",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.4 <9.0",
    "adbario/php-dot-notation": "^3.2.1",
    "austral/contracts": "^4.0",
    "austral/tools-bundle": "^4.0",
    "doctrine/collections": "^2.2 || ^3.1",
    "doctrine/dbal": "^4.0",
    "doctrine/doctrine-bundle": "^3.2.2",
    "doctrine/orm": "^3.7",
    "gedmo/doctrine-extensions": "^3.0",
    "ramsey/uuid": "^4.9.1",
    "symfony/config": "^7.4",
    "symfony/console": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/event-dispatcher": "^7.4",
    "symfony/event-dispatcher-contracts": "^3.5",
    "symfony/filesystem": "^7.4",
    "symfony/html-sanitizer": "^7.4",
    "symfony/http-kernel": "^7.4",
    "symfony/property-access": "^7.4",
    "symfony/string": "^7.4",
    "symfony/property-info": "^7.4",
    "symfony/yaml": "^7.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^11.5"
  },
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Austral\\EntityBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Austral\\EntityBundle\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php -d assert.exception=1 vendor/bin/phpunit",
    "stan": "vendor/bin/phpstan analyse",
    "rector": "vendor/bin/rector process --ansi"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "symfony": {
      "allow-contrib": true
    }
  }
}
