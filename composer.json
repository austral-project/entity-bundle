{
    "name": "austral/entity-bundle",
    "type": "symfony-bundle",
    "description": "Tools for Symfony Entity",
    "keywords": [
        "Austral",
        "Entity",
        "Symfony",
        "EntityManager"
    ],
    "license": "MIT",
    "homepage": "https://austral.dev",
    "authors": [
        {
            "name": "Matthieu Beurel",
            "email": "matthieu@austral.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4 <9.0",
        "austral/contracts": "^4.0",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^3.0",
        "doctrine/orm": "^3.2",
        "symfony/string": "^7.4",
        "symfony/html-sanitizer": "^7.4",
        "gedmo/doctrine-extensions": "^3.0",
        "ramsey/uuid": "^4.9.1",
        "adbario/php-dot-notation": "^3.2.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Austral\\EntityBundle\\": ""
        }
    },
    "scripts": {
        "test": "php -d assert.exception=1 vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse",
        "rector": "vendor/bin/rector process --ansi"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "symfony": {
            "allow-contrib": true
        }
    }
}
